    <string name="memory_note">Todo lo que Mushin ha aprendido se queda en este teléfono. Aquí puedes verlo y borrarlo.</string>
    <string name="memory_gestures">Gestos aprendidos</string>
    <string name="memory_gestures_none">Nada todavía. Un gesto se recuerda cuando abres una app después de corregir un trazo o elegir entre las sugerencias.</string>
    <string name="memory_forget_gestures">Olvidar todos los gestos</string>
    <string name="memory_forget_gestures_confirm">¿Olvidar todos los gestos aprendidos? El reconocimiento volverá a su estado inicial.</string>
    <string name="memory_usage">Frecuencia de uso</string>
