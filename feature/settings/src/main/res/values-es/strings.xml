    <string name="memory_usage_none">Vacío por ahora.</string>
    <string name="memory_clear_usage">Borrar historial de aperturas</string>
    <string name="memory_clear_usage_confirm">¿Borrar el historial de aperturas de todas las apps? Se eliminan los recuentos, las apps recientes de la búsqueda y los días usados para las sugerencias. La búsqueda y las sugerencias volverán a aprender.</string>
    <string name="memory_erase">Borrar</string>
    <string name="memory_app_note">Trazos que llevan a esta app, mostrados como vectores. El punto marca dónde empieza la línea; un anillo marca dónde se detuvo el dedo: cuanto más larga la pausa, más grande el anillo. Cuanto mayor es el peso, más apunta el trazo a esta app.</string>
