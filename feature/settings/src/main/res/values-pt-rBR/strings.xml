    <string name="memory_erase">Apagar</string>
    <string name="memory_app_note">Desenhos que levam a este app, mostrados como vetores. O ponto marca onde a linha começa; um anel marca onde o dedo parou: quanto maior a pausa, maior o anel. Quanto maior o peso, mais o desenho aponta para este app.</string>
